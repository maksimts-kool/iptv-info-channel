# =============================================================================
# IPTV Panel — configuration
#
# Copy to `.env` and edit. Every value below is shown at its default, so an
# unedited copy behaves exactly like setting nothing. Variables already present
# in the environment (shell export, Docker `environment:`) win over this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Networking & access
# -----------------------------------------------------------------------------
# Public base URL clients use to reach this server — baked into every generated
# .m3u/HLS link. On a LAN set this to the host machine IP (e.g.
# http://192.168.1.50:9222), NEVER localhost, or players get links they can't
# reach. Off-LAN use an https:// origin so the per-user token isn't sent in clear.
PUBLIC_BASE_URL=http://localhost:9222
# TCP port the server listens on.
PORT=9222
# Timezone for day-counting, expiry, the daily refresh and displayed dates.
TZ=Europe/Tallinn
# Trusted reverse-proxy hops for client IP detection (used by the /sub + admin
# login rate limiters). Set to 1 behind one proxy (nginx / DO load balancer);
# leave blank on a directly-exposed port so clients can't spoof X-Forwarded-For.
TRUST_PROXY=
# Password for the /admin web panel. CHANGE THIS.
ADMIN_PASSWORD=changeme
# Secret that signs the admin session cookie. CHANGE THIS to a long random
# string; rotating it invalidates all existing admin sessions.
SESSION_SECRET=please-change-this-to-a-long-random-string

# -----------------------------------------------------------------------------
# 2. Channel catalog (the customer playlist)
# -----------------------------------------------------------------------------
# Upstream provider playlists are added in the admin (/admin -> Плейлист ->
# Источники), not here — these settings only bound how they are fetched.
# Milliseconds before an upstream playlist download is abandoned.
CATALOG_FETCH_TIMEOUT_MS=30000
# Hard cap on a downloaded playlist, in bytes, so a bad URL can't exhaust memory.
CATALOG_MAX_BYTES=33554432
# Master switch for unattended re-downloading. Each source then carries its own
# "Авто-обновление" toggle and interval, set in the admin; with this off the
# schedules are kept but never run, and sources refresh only on the button.
CATALOG_AUTO_REFRESH=true
# How often the scheduler looks for a source that has come due. This is the
# polling granularity, NOT the refresh interval (that is per source).
CATALOG_REFRESH_CHECK_MINUTES=5
# Interval a newly added source starts with, in hours. 24 = once a day.
CATALOG_REFRESH_INTERVAL_HOURS=24
# Display name of the built-in category holding this server's info channel. It
# is the only category an expired customer keeps, so it can't be switched off.
INFO_CATEGORY_NAME=Информация
# Stream gateway. false: the .m3u carries the provider's own stream URLs, so a
# player that downloaded the playlist once keeps playing them — this server
# never sees the request and cannot take a channel back. true: every HLS channel
# points at /c/<token>/<channel id>.m3u8 here, where access is re-checked on
# request and the provider's manifest is served back with its URIs rewritten to
# absolute provider URLs. No video is proxied (segments still go provider ->
# player), and revoking a category or letting a subscription lapse stops
# playback within seconds, without a playlist refresh; a channel the customer
# may not watch redirects to their own info channel instead of failing.
#
# ONLY HLS (.m3u8) CHANNELS ARE GATED. A raw MPEG-TS stream has no manifest to
# rewrite, and gating it would require a redirect from this server's https to
# the provider's http, which Android players (ExoPlayer) refuse to follow —
# the channel would buffer forever. Those channels stay direct.
#
# Also togglable in the admin (Плейлист -> Доступ), which overrides this
# default. Switching it on reaches a customer only once their player
# re-downloads the playlist.
STREAM_GATEWAY_ENABLED=false
# Milliseconds before a provider manifest fetch is abandoned. Short on purpose:
# a viewer is waiting on the channel to open while this runs.
STREAM_GATEWAY_TIMEOUT_MS=10000
# Hard cap on a fetched manifest. A media playlist is kilobytes; anything near
# this is a misconfigured URL, not a channel.
STREAM_GATEWAY_MAX_BYTES=4194304
# Log every gate hit (not just refusals) with the client's User-Agent. One line
# per channel switch, so leave it off in normal operation — turn it on to find
# out whether a player that "loads forever" ever reached this server at all.
STREAM_GATEWAY_LOG=false

# -----------------------------------------------------------------------------
# 3. Info channel look & timing
# -----------------------------------------------------------------------------
# Output resolution. 720p + low frame rates look identical on a TV (the card is
# a still image) but cost far less CPU to encode on a small host.
CHANNEL_WIDTH=1920
CHANNEL_HEIGHT=1080
# Frame rate for the animated intro path (has a short xfade transition).
CHANNEL_FPS=12
# Frame rate for the plain still-card path (no intro). Very low = cheap.
CHANNEL_STILL_FPS=4
# libx264 speed preset. For a static image the quality cost of ultrafast is
# irrelevant while the CPU saving is large.
FFMPEG_PRESET=ultrafast
# HLS segment length in seconds (keyframes are forced on these boundaries).
HLS_TIME=6
# Seconds the account (info) card stays on screen — its own slide duration, like
# the intro/status slides. The loop total is the sum of every enabled slide,
# rounded to whole HLS segments — and, when CHANNEL_LIVE_LOOP is on, never
# shorter than the 8-segment live window (8 x HLS_TIME = 48s by default), since
# a shorter loop repeats inside one playlist and strict players stall on the
# wrap. The card absorbs that difference, so if the slides should rotate faster
# than 48s, lower HLS_TIME rather than these seconds.
ACCOUNT_SLIDE_SECONDS=15
# Serve a sliding, endless LIVE HLS playlist instead of a finite VOD clip.
CHANNEL_LIVE_LOOP=true
# Days-left threshold below which the status turns to "EXPIRING SOON".
EXPIRING_THRESHOLD_DAYS=7
# Bottom-right "next slide in N" countdown, baked in via ffmpeg drawtext.
SLIDE_TIMER_ENABLED=true
# Font for that countdown. Blank = fontconfig name "Inter" (the Docker image
# installs it). On a host without fontconfig, set a .ttf path (forward slashes).
TIMER_FONT_FILE=
# Animated brand intro shown before the account card.
INTRO_ENABLED=true
# Seconds each brand slide is on screen (incl. its share of the transition).
INTRO_SLIDE_SECONDS=4
# xfade transition from the brand slide into the card (slideleft, fade,
# wipeleft, dissolve, smoothleft, ...).
INTRO_TRANSITION=slideleft

# -----------------------------------------------------------------------------
# 4. Global slides (shared by all users)
# -----------------------------------------------------------------------------
# Better Stack–style service-status board appended to the loop.
STATUS_SLIDE_ENABLED=true
# Seconds the status board is held on screen each loop.
STATUS_SLIDE_SECONDS=12

# -----------------------------------------------------------------------------
# 5. EPG / programme guide
# -----------------------------------------------------------------------------
# Advertise a per-user XMLTV guide via url-tvg in each .m3u (served at
# /u/:token/epg.xml). Programmes show service status + the account's own status.
EPG_ENABLED=true
# Calendar days of schedule emitted ahead of / behind today.
EPG_DAYS_AHEAD=7
EPG_DAYS_BEHIND=1
# Also serve the OTT-play FOSS JSON guide + match protocol (needs EPG_ENABLED).
EPG_FOSS_ENABLED=true
# Provider id this server advertises in the FOSS source definition.
EPG_FOSS_PROVIDER_ID=infochannel
# Upstream OTT-play match server whose response is merged into ours so this
# server works as a drop-in !epg-server in a combined playlist.
EPG_FOSS_UPSTREAM_MATCH_URL=https://ottp.eu.org

# -----------------------------------------------------------------------------
# 6. Email notifications (intro-slide QR -> /sub/:token sign-up)
# -----------------------------------------------------------------------------
# Master on/off. Mail is sent over a third-party HTTP email API (HTTPS:443)
# because DigitalOcean blocks outbound SMTP ports. Off by default.
NOTIFY_ENABLED=false
# HTTP send provider: brevo (api.brevo.com) or resend (api.resend.com).
NOTIFY_PROVIDER=brevo
# API key from the provider dashboard, plus the verified sender + display name.
NOTIFY_API_KEY=
NOTIFY_FROM=
NOTIFY_FROM_NAME=IPTV Info Channel
# Log emails instead of sending them — handy for local/Docker testing (no key).
NOTIFY_DRY_RUN=false

# -----------------------------------------------------------------------------
# 7. Storage & assets
# -----------------------------------------------------------------------------
# Directory for the JSON data stores (db.json + catalog.json) and generated HLS
# output (mounted as a volume in Docker).
DATA_DIR=data
# Background music (relative to project root). If missing, a placeholder tone is
# synthesized on startup.
MUSIC_FILE=assets/music/background.mp3
# ffmpeg binary. Leave unset to use `ffmpeg` from PATH; set a full path only if
# ffmpeg lives elsewhere.
# FFMPEG_PATH=/usr/bin/ffmpeg
