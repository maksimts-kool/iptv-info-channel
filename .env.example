# ---- Server ----
PORT=9222
# Public base URL clients use to reach this server (used in generated .m3u files).
# In Docker/LAN set this to e.g. http://192.168.1.50:9222
PUBLIC_BASE_URL=http://localhost:9222
# Timezone used for logs, scheduled refreshes and displayed update dates.
TZ=Europe/Tallinn

# ---- Admin panel ----
# Password for the /admin web config. CHANGE THIS.
ADMIN_PASSWORD=changeme
# Secret used to sign the admin session cookie. CHANGE THIS to a long random string.
SESSION_SECRET=please-change-this-to-a-long-random-string

# ---- Channel / video ----
# Length in seconds of the generated looping video (static info card, compresses tiny).
CHANNEL_DURATION=120
# Output resolution.
CHANNEL_WIDTH=1920
CHANNEL_HEIGHT=1080
# Days-left threshold below which the status banner turns to "EXPIRING SOON".
EXPIRING_THRESHOLD_DAYS=7

# ---- Branding intro animation ----
# Animated brand slide shown before the user-details card.
INTRO_ENABLED=true
# Seconds the brand slide stays on screen before transitioning to the card.
INTRO_SLIDE_SECONDS=4
# Transition from the brand slide into the card (xfade): slideleft, fade, wipeleft, dissolve, smoothleft, ...
INTRO_TRANSITION=slideleft
# Background music file (relative to project root). If missing, a placeholder is synthesized.
MUSIC_FILE=assets/music/background.mp3

# ---- Data ----
# Directory for the SQLite db + generated HLS output (mounted as a volume in Docker).
DATA_DIR=data
