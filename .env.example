# ---- Server ----
PORT=9222
# Public base URL clients use to reach this server (used in generated .m3u files).
# In Docker/LAN set this to e.g. http://192.168.1.50:9222
PUBLIC_BASE_URL=http://localhost:9222
# Timezone used for logs, scheduled refreshes and displayed update dates.
TZ=Europe/Tallinn

# ---- Admin panel ----
# Password for the /admin web config. CHANGE THIS.
ADMIN_PASSWORD=changeme
# Secret used to sign the admin session cookie. CHANGE THIS to a long random string.
SESSION_SECRET=please-change-this-to-a-long-random-string
# Trusted reverse-proxy hops for client IP detection (used by the /sub rate
# limiter). Set to 1 behind one proxy (nginx / DO load balancer); leave blank on
# a directly-exposed port so clients can't spoof X-Forwarded-For.
TRUST_PROXY=

# ---- Channel / video ----
# Seconds the account (info) card stays on screen — its own slide duration, like
# the intro/status/World Cup slides. The loop total is the sum of every enabled
# slide (rounded up to whole HLS segments).
ACCOUNT_SLIDE_SECONDS=15
# Output resolution.
CHANNEL_WIDTH=1920
CHANNEL_HEIGHT=1080
# Serve a sliding live HLS playlist with no end instead of a finite VOD.
CHANNEL_LIVE_LOOP=true
# Days-left threshold below which the status banner turns to "EXPIRING SOON".
EXPIRING_THRESHOLD_DAYS=7

# ---- World Cup 2026 bracket slide ----
# Auto-updating knockout-bracket frame (single global slide, shared by all users).
# Off by default. When on, the loop gains a bracket frame after the card/status.
WORLDCUP_SLIDE_ENABLED=false
# Seconds the bracket is held on screen each loop.
WORLDCUP_SLIDE_SECONDS=14
# Free results feed (football-data.org). Register a free token at
# https://www.football-data.org/client/register and set it here. WITHOUT a token
# the bracket still renders the seeding skeleton (group winners / placeholders),
# just no live teams or scores. Refreshed by the daily 00:05 cron.
FOOTBALL_API_TOKEN=
# Override only if you use a different provider/endpoint or competition code.
FOOTBALL_API_BASE=https://api.football-data.org/v4
FOOTBALL_API_COMPETITION=WC
# Minutes a fetched bracket is cached before a lazy refresh re-fetches it.
FOOTBALL_API_TTL_MINUTES=360

# ---- EPG (XMLTV programme guide) ----
# Advertise a per-user XMLTV guide via url-tvg in each .m3u. The now/next
# programmes show the service status (working / degraded / outage) plus the
# account's own subscription status. Served at /u/:token/epg.xml.
EPG_ENABLED=true
# Calendar days of schedule emitted ahead of / behind today.
EPG_DAYS_AHEAD=7
EPG_DAYS_BEHIND=1

# ---- Branding intro animation ----
# Animated brand slide shown before the user-details card.
INTRO_ENABLED=true
# Seconds the brand slide stays on screen before transitioning to the card.
INTRO_SLIDE_SECONDS=4
# Transition from the brand slide into the card (xfade): slideleft, fade, wipeleft, dissolve, smoothleft, ...
INTRO_TRANSITION=slideleft
# Background music file (relative to project root). If missing, a placeholder is synthesized.
MUSIC_FILE=assets/music/background.mp3

# ---- Data ----
# Directory for the JSON data store (db.json) + generated HLS output (mounted as a volume in Docker).
DATA_DIR=data

# ---- Email notifications ----
# Customers scan the intro-slide QR to open /sub/:token and subscribe with their
# email. Mail is sent over a third-party HTTP email API (HTTPS:443) because
# DigitalOcean blocks outbound SMTP ports. Off by default.
NOTIFY_ENABLED=false
# Provider for the HTTP send API: brevo (api.brevo.com) or resend (api.resend.com).
NOTIFY_PROVIDER=brevo
# API key from the provider dashboard, the verified sender address and display name.
NOTIFY_API_KEY=
NOTIFY_FROM=
NOTIFY_FROM_NAME=IPTV Info Channel
# Log emails instead of sending them — handy for local/Docker testing without a key.
NOTIFY_DRY_RUN=false
